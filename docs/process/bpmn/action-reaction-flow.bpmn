        <di:waypoint x="1790" y="690"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AR_11_di" bpmnElement="AR_11">
        <di:waypoint x="1100" y="510"/>
        <di:waypoint x="1200" y="510"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1140" y="488" width="20" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AR_12_di" bpmnElement="AR_12">
        <di:waypoint x="1330" y="510"/>
        <di:waypoint x="1390" y="510"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AR_13_di" bpmnElement="AR_13">
        <di:waypoint x="1520" y="510"/>
        <di:waypoint x="2040" y="510"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AR_03_di" bpmnElement="AR_03">
        <di:waypoint x="480" y="870"/>
        <di:waypoint x="2058" y="870"/>
        <di:waypoint x="2058" y="528"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
