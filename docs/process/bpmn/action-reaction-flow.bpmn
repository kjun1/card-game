        <di:waypoint x="1075" y="535"/>
        <di:waypoint x="1075" y="690"/>
        <di:waypoint x="1200" y="690"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1085" y="610" width="20" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AR_08_di" bpmnElement="AR_08">
        <di:waypoint x="1330" y="690"/>
        <di:waypoint x="1390" y="690"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1itt36p_di" bpmnElement="Flow_1itt36p">
        <di:waypoint x="1520" y="690"/>
        <di:waypoint x="1580" y="690"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AR_10_di" bpmnElement="AR_10">
