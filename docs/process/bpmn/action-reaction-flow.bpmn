      <bpmndi:BPMNEdge id="AR_13_di" bpmnElement="AR_13">
        <di:waypoint x="1115" y="710" />
        <di:waypoint x="1442" y="710" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AR_05_di" bpmnElement="AR_05">
        <di:waypoint x="125" y="125" />
        <di:waypoint x="480" y="125" />
        <di:waypoint x="480" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AR_03_di" bpmnElement="AR_03">
        <di:waypoint x="215" y="750" />
        <di:waypoint x="215" y="800" />
        <di:waypoint x="1460" y="800" />
        <di:waypoint x="1460" y="728" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AR_10_di" bpmnElement="AR_10">
        <di:waypoint x="1275" y="870" />
        <di:waypoint x="1442" y="870" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AR_06_di" bpmnElement="AR_06">
        <di:waypoint x="480" y="500" />
        <di:waypoint x="480" y="685" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1itt36p_di" bpmnElement="Flow_1itt36p">
        <di:waypoint x="925" y="870" />
        <di:waypoint x="1145" y="870" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
