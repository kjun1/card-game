      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_HandLimit_di" bpmnElement="Gateway_HandLimit" isMarkerVisible="true">
        <dc:Bounds x="1180" y="345" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1145" y="405" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SelectOperation_di" bpmnElement="Task_SelectOperation">
        <dc:Bounds x="1300" y="140" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ExecuteOperation_di" bpmnElement="Task_ExecuteOperation">
        <dc:Bounds x="1510" y="330" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_GameEndedTurn_di" bpmnElement="Gateway_GameEndedTurn" isMarkerVisible="true">
        <dc:Bounds x="1690" y="345" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1660" y="303" width="110" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_OperationCompleted_di" bpmnElement="Gateway_OperationCompleted" isMarkerVisible="true">
        <dc:Bounds x="1830" y="345" width="50" height="50" />
