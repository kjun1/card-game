          <dc:Bounds x="1800" y="405" width="110" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DiscardDrawn_di" bpmnElement="Task_DiscardDrawn">
        <dc:Bounds x="1300" y="330" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_GameEndedTurn_di" bpmnElement="End_GameEndedTurn">
        <dc:Bounds x="1697" y="472" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1670" y="516" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Turn_di" bpmnElement="End_Turn">
        <dc:Bounds x="1980" y="352" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1948" y="400" width="100" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_LoseDeckOut_di" bpmnElement="End_LoseDeckOut">
        <dc:Bounds x="927" y="472" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="885" y="516" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
