      <bpmndi:BPMNShape id="Task_IncreaseCapacity_di" bpmnElement="Task_IncreaseCapacity">
        <dc:Bounds x="580" y="330" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RefreshEnergy_di" bpmnElement="Task_RefreshEnergy">
        <dc:Bounds x="750" y="330" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_CanDraw_di" bpmnElement="Gateway_CanDraw" isMarkerVisible="true">
        <dc:Bounds x="920" y="345" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="890" y="303" width="110" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Draw_di" bpmnElement="Task_Draw">
