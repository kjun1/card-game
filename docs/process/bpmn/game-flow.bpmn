      <bpmndi:BPMNShape id="Task_ReturnShuffleA_di" bpmnElement="Task_ReturnShuffleA">
        <dc:Bounds x="1470" y="100" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReturnShuffleB_di" bpmnElement="Task_ReturnShuffleB">
        <dc:Bounds x="1470" y="260" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ReturnJoin_di" bpmnElement="Gateway_ReturnJoin">
        <dc:Bounds x="1670" y="455" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Initialize_di" bpmnElement="Task_Initialize">
        <dc:Bounds x="1760" y="440" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ExecuteTurn_di" bpmnElement="Task_ExecuteTurn">
        <dc:Bounds x="1930" y="440" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_GameEnded_di" bpmnElement="Gateway_GameEnded" isMarkerVisible="true">
        <dc:Bounds x="2100" y="455" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2070" y="410" width="110" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Game_di" bpmnElement="End_Game">
        <dc:Bounds x="2360" y="462" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2333" y="512" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Game_di" bpmnElement="Start_Game">
        <dc:Bounds x="150" y="462" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="123" y="512" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SwitchActivePlayer_di" bpmnElement="Task_SwitchActivePlayer">
        <dc:Bounds x="2060" y="580" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DetermineResult_di" bpmnElement="Task_DetermineResult">
        <dc:Bounds x="2190" y="440" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="GF_01_di" bpmnElement="GF_01">
        <di:waypoint x="186" y="480" />
        <di:waypoint x="250" y="480" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="GF_02_di" bpmnElement="GF_02">
        <di:waypoint x="275" y="455" />
        <di:waypoint x="275" y="140" />
        <di:waypoint x="350" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="GF_03_di" bpmnElement="GF_03">
        <di:waypoint x="300" y="480" />
