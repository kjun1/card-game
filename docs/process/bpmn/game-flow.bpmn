<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_GameFlow"
  targetNamespace="https://github.com/kjun1/card-game/bpmn">

  <bpmn:collaboration id="Collaboration_GameFlow">
    <bpmn:participant id="Participant_Game" name="Card Game" processRef="Process_GameFlow"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_GameFlow" name="Game Flow" isExecutable="false">
    <bpmn:laneSet id="LaneSet_GameFlow">
      <bpmn:lane id="Lane_PlayerA" name="Player A">
        <bpmn:flowNodeRef>Task_PrepareDeckA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MulliganA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnShuffleA</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PlayerB" name="Player B">
        <bpmn:flowNodeRef>Task_PrepareDeckB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MulliganB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnShuffleB</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GameSystem" name="Game System">
        <bpmn:flowNodeRef>Start_Game</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PrepareSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PrepareJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CoinToss</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OpeningDraw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MulliganSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MulliganJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReturnSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReturnJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Initialize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExecuteTurn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_GameEnded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SwitchActivePlayer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DetermineResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Game</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Game" name="Game Start"/>
    <bpmn:parallelGateway id="Gateway_PrepareSplit" name="Prepare Decks"/>
    <bpmn:userTask id="Task_PrepareDeckA" name="Prepare Deck A"/>
    <bpmn:userTask id="Task_PrepareDeckB" name="Prepare Deck B"/>
    <bpmn:parallelGateway id="Gateway_PrepareJoin"/>
    <bpmn:serviceTask id="Task_CoinToss" name="Coin Toss / Determine First Player"/>
    <bpmn:serviceTask id="Task_OpeningDraw" name="Deal Opening Hands"/>
    <bpmn:parallelGateway id="Gateway_MulliganSplit" name="Mulligan"/>
    <bpmn:userTask id="Task_MulliganA" name="Select Mulligan Cards A">
      <bpmn:documentation>Select 0-5 cards, set them aside, and draw the same number.</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:userTask id="Task_MulliganB" name="Select Mulligan Cards B">
      <bpmn:documentation>Select 0-5 cards, set them aside, and draw the same number.</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gateway_MulliganJoin"/>
    <bpmn:parallelGateway id="Gateway_ReturnSplit"/>
    <bpmn:userTask id="Task_ReturnShuffleA" name="Return Set-aside Cards and Shuffle A"/>
    <bpmn:userTask id="Task_ReturnShuffleB" name="Return Set-aside Cards and Shuffle B"/>
    <bpmn:parallelGateway id="Gateway_ReturnJoin"/>
    <bpmn:serviceTask id="Task_Initialize" name="Initialize Core / Energy / Momentum"/>
    <bpmn:task id="Task_ExecuteTurn" name="Execute Active Player Turn">
      <bpmn:documentation>Detailed in turn-flow.bpmn.</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_GameEnded" name="Game End Condition Met?"/>
    <bpmn:serviceTask id="Task_SwitchActivePlayer" name="Switch Active Player"/>
    <bpmn:serviceTask id="Task_DetermineResult" name="Determine Win / Lose / Draw"/>
    <bpmn:endEvent id="End_Game" name="Game End"/>

    <bpmn:sequenceFlow id="GF_01" sourceRef="Start_Game" targetRef="Gateway_PrepareSplit"/>
    <bpmn:sequenceFlow id="GF_02" sourceRef="Gateway_PrepareSplit" targetRef="Task_PrepareDeckA"/>
    <bpmn:sequenceFlow id="GF_03" sourceRef="Gateway_PrepareSplit" targetRef="Task_PrepareDeckB"/>
    <bpmn:sequenceFlow id="GF_04" sourceRef="Task_PrepareDeckA" targetRef="Gateway_PrepareJoin"/>
    <bpmn:sequenceFlow id="GF_05" sourceRef="Task_PrepareDeckB" targetRef="Gateway_PrepareJoin"/>
    <bpmn:sequenceFlow id="GF_06" sourceRef="Gateway_PrepareJoin" targetRef="Task_CoinToss"/>
    <bpmn:sequenceFlow id="GF_07" sourceRef="Task_CoinToss" targetRef="Task_OpeningDraw"/>
    <bpmn:sequenceFlow id="GF_08" sourceRef="Task_OpeningDraw" targetRef="Gateway_MulliganSplit"/>
    <bpmn:sequenceFlow id="GF_09" sourceRef="Gateway_MulliganSplit" targetRef="Task_MulliganA"/>
    <bpmn:sequenceFlow id="GF_10" sourceRef="Gateway_MulliganSplit" targetRef="Task_MulliganB"/>
    <bpmn:sequenceFlow id="GF_11" sourceRef="Task_MulliganA" targetRef="Gateway_MulliganJoin"/>
    <bpmn:sequenceFlow id="GF_12" sourceRef="Task_MulliganB" targetRef="Gateway_MulliganJoin"/>
    <bpmn:sequenceFlow id="GF_13" sourceRef="Gateway_MulliganJoin" targetRef="Gateway_ReturnSplit"/>
    <bpmn:sequenceFlow id="GF_14" sourceRef="Gateway_ReturnSplit" targetRef="Task_ReturnShuffleA"/>
    <bpmn:sequenceFlow id="GF_15" sourceRef="Gateway_ReturnSplit" targetRef="Task_ReturnShuffleB"/>
    <bpmn:sequenceFlow id="GF_16" sourceRef="Task_ReturnShuffleA" targetRef="Gateway_ReturnJoin"/>
    <bpmn:sequenceFlow id="GF_17" sourceRef="Task_ReturnShuffleB" targetRef="Gateway_ReturnJoin"/>
    <bpmn:sequenceFlow id="GF_18" sourceRef="Gateway_ReturnJoin" targetRef="Task_Initialize"/>
    <bpmn:sequenceFlow id="GF_19" sourceRef="Task_Initialize" targetRef="Task_ExecuteTurn"/>
    <bpmn:sequenceFlow id="GF_20" sourceRef="Task_ExecuteTurn" targetRef="Gateway_GameEnded"/>
    <bpmn:sequenceFlow id="GF_21" name="No" sourceRef="Gateway_GameEnded" targetRef="Task_SwitchActivePlayer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[not(gameEnded)]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="GF_22" sourceRef="Task_SwitchActivePlayer" targetRef="Task_ExecuteTurn"/>
    <bpmn:sequenceFlow id="GF_23" name="Yes" sourceRef="Gateway_GameEnded" targetRef="Task_DetermineResult">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[gameEnded]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="GF_24" sourceRef="Task_DetermineResult" targetRef="End_Game"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Collaboration_GameFlow">
    <bpmndi:BPMNPlane id="BPMNPlane_Collaboration_GameFlow" bpmnElement="Collaboration_GameFlow">
      <bpmndi:BPMNShape id="Participant_Game_di" bpmnElement="Participant_Game" isHorizontal="true">
        <dc:Bounds x="60" y="60" width="3600" height="900"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_PlayerA_di" bpmnElement="Lane_PlayerA" isHorizontal="true">
        <dc:Bounds x="90" y="60" width="3570" height="300"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_PlayerB_di" bpmnElement="Lane_PlayerB" isHorizontal="true">
        <dc:Bounds x="90" y="360" width="3570" height="300"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_GameSystem_di" bpmnElement="Lane_GameSystem" isHorizontal="true">
        <dc:Bounds x="90" y="660" width="3570" height="300"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Game_di" bpmnElement="Start_Game">
        <dc:Bounds x="180" y="715" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_PrepareSplit_di" bpmnElement="Gateway_PrepareSplit">
        <dc:Bounds x="370" y="715" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PrepareDeckA_di" bpmnElement="Task_PrepareDeckA">
        <dc:Bounds x="560" y="115" width="130" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PrepareDeckB_di" bpmnElement="Task_PrepareDeckB">
        <dc:Bounds x="560" y="415" width="130" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_PrepareJoin_di" bpmnElement="Gateway_PrepareJoin">
        <dc:Bounds x="750" y="715" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CoinToss_di" bpmnElement="Task_CoinToss">
        <dc:Bounds x="940" y="715" width="130" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_OpeningDraw_di" bpmnElement="Task_OpeningDraw">
        <dc:Bounds x="1130" y="715" width="130" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_MulliganSplit_di" bpmnElement="Gateway_MulliganSplit">
        <dc:Bounds x="1320" y="715" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_MulliganA_di" bpmnElement="Task_MulliganA">
        <dc:Bounds x="1510" y="115" width="130" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_MulliganB_di" bpmnElement="Task_MulliganB">
        <dc:Bounds x="1510" y="415" width="130" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_MulliganJoin_di" bpmnElement="Gateway_MulliganJoin">
        <dc:Bounds x="1700" y="715" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ReturnSplit_di" bpmnElement="Gateway_ReturnSplit">
        <dc:Bounds x="1890" y="715" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReturnShuffleA_di" bpmnElement="Task_ReturnShuffleA">
        <dc:Bounds x="2080" y="115" width="130" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReturnShuffleB_di" bpmnElement="Task_ReturnShuffleB">
        <dc:Bounds x="2080" y="415" width="130" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ReturnJoin_di" bpmnElement="Gateway_ReturnJoin">
        <dc:Bounds x="2270" y="715" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Initialize_di" bpmnElement="Task_Initialize">
        <dc:Bounds x="2460" y="715" width="130" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ExecuteTurn_di" bpmnElement="Task_ExecuteTurn">
        <dc:Bounds x="2650" y="715" width="130" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_GameEnded_di" bpmnElement="Gateway_GameEnded">
        <dc:Bounds x="2840" y="715" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SwitchActivePlayer_di" bpmnElement="Task_SwitchActivePlayer">
        <dc:Bounds x="3030" y="715" width="130" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DetermineResult_di" bpmnElement="Task_DetermineResult">
        <dc:Bounds x="3030" y="815" width="130" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Game_di" bpmnElement="End_Game">
        <dc:Bounds x="3220" y="715" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="GF_01_di" bpmnElement="GF_01">
        <di:waypoint x="216" y="733"/>
        <di:waypoint x="293" y="733"/>
        <di:waypoint x="293" y="740"/>
        <di:waypoint x="370" y="740"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="GF_02_di" bpmnElement="GF_02">
        <di:waypoint x="420" y="740"/>
        <di:waypoint x="490" y="740"/>
        <di:waypoint x="490" y="155"/>
        <di:waypoint x="560" y="155"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="GF_03_di" bpmnElement="GF_03">
