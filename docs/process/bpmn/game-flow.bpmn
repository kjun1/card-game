        <di:waypoint x="1100" y="755"/>
        <di:waypoint x="1130" y="755"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="GF_08_di" bpmnElement="GF_08">
        <di:waypoint x="1260" y="755"/>
        <di:waypoint x="1290" y="755"/>
        <di:waypoint x="1290" y="740"/>
        <di:waypoint x="1320" y="740"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="GF_09_di" bpmnElement="GF_09">
        <di:waypoint x="1370" y="740"/>
        <di:waypoint x="1440" y="740"/>
        <di:waypoint x="1440" y="155"/>
        <di:waypoint x="1510" y="155"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="GF_10_di" bpmnElement="GF_10">
