<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_AttackFlow" targetNamespace="https://github.com/kjun1/card-game/bpmn">
  <bpmn:collaboration id="Collaboration_AttackFlow">
    <bpmn:participant id="Participant_Attack" name="Attack" processRef="Process_AttackFlow" />
  </bpmn:collaboration>
  <bpmn:process id="Process_AttackFlow" name="Attack Flow" isExecutable="false">
    <bpmn:documentation>Common Resolution contract: see ../../model/effect-resolution-model.md. Resolve ordered EffectSteps, checking defeat conditions after each sequential application. Apply an explicit SimultaneousGroup atomically, then check once; do not split it into Player order. When an Effect sequentially applies to both Players, process Active Player first and Opponent only if the Game continues. Do not reorder separate EffectSteps, change targets, or process a Player not affected by that Effect. Draw remains one card at a time under Deck Rules. Fix the first terminal result, stop remaining EffectSteps, and preserve paid costs and applied effects.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_AttackFlow">
      <bpmn:lane id="Lane_Attacker" name="Attacking Player">
        <bpmn:flowNodeRef>Task_DeclareAttack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_AttackSelected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Defender" name="Defending Player">
        <bpmn:flowNodeRef>Task_SelectBlockingUnit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChooseReactionAttack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChooseBlock</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AttackSystem" name="Game System">
        <bpmn:flowNodeRef>Task_AttackCommit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExhaustAttacker</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Block</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AttackReaction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChangeFinalTarget</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResolveAttackReaction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CancelAttack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_AttackCancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TargetType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DamageCore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AttackGameEnded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_AttackGameEnded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DamageUnits</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DestroyCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_AttackComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PayAttackReactionCost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateAttack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AttackValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateAttackReaction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AttackReactionValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateBlock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_BlockValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PayBlockCost</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="Task_DeclareAttack" name="Declare Attacker and Target">
      <bpmn:incoming>AT_01</bpmn:incoming>
      <bpmn:incoming>AT_26</bpmn:incoming>
      <bpmn:outgoing>AT_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="AT_01" sourceRef="Start_AttackSelected" targetRef="Task_DeclareAttack" />
    <bpmn:sequenceFlow id="AT_02" sourceRef="Task_DeclareAttack" targetRef="Task_ValidateAttack" />
    <bpmn:sequenceFlow id="AT_03" sourceRef="Task_ChooseReactionAttack" targetRef="Task_ValidateAttackReaction" />
    <bpmn:sequenceFlow id="AT_04" name="Yes" sourceRef="Gateway_AttackReaction" targetRef="Task_PayAttackReactionCost">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">useReaction</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="AT_05" sourceRef="Task_PayAttackReactionCost" targetRef="Task_ResolveAttackReaction" />
    <bpmn:sequenceFlow id="AT_08" name="No" sourceRef="Gateway_AttackReaction" targetRef="Task_ChooseBlock">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not(useReaction)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="AT_09" sourceRef="Task_ChooseBlock" targetRef="Gateway_Block" />
    <bpmn:sequenceFlow id="AT_10" name="Yes" sourceRef="Gateway_Block" targetRef="Task_SelectBlockingUnit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">useBlock</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="AT_11" sourceRef="Task_SelectBlockingUnit" targetRef="Task_ValidateBlock" />
    <bpmn:sequenceFlow id="AT_12" sourceRef="Task_ChangeFinalTarget" targetRef="Task_AttackCommit" />
    <bpmn:sequenceFlow id="AT_13" name="No" sourceRef="Gateway_Block" targetRef="Task_AttackCommit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not(useBlock)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="AT_14" sourceRef="Task_AttackCommit" targetRef="Task_ExhaustAttacker" />
    <bpmn:sequenceFlow id="AT_15" sourceRef="Task_ExhaustAttacker" targetRef="Gateway_TargetType" />
    <bpmn:sequenceFlow id="AT_16" name="Core" sourceRef="Gateway_TargetType" targetRef="Task_DamageCore">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">finalTargetType = "CORE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="AT_17" name="Unit" sourceRef="Gateway_TargetType" targetRef="Task_DamageUnits">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">finalTargetType = "UNIT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="AT_20" sourceRef="Task_DamageCore" targetRef="Gateway_AttackGameEnded" />
    <bpmn:startEvent id="Start_AttackSelected" name="Attack Operation Selected">
      <bpmn:outgoing>AT_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_SelectBlockingUnit" name="Select Blocking Unit">
      <bpmn:incoming>AT_10</bpmn:incoming>
      <bpmn:outgoing>AT_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_AttackCommit" name="Attack Commit">
      <bpmn:incoming>AT_12</bpmn:incoming>
      <bpmn:incoming>AT_13</bpmn:incoming>
      <bpmn:outgoing>AT_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ExhaustAttacker" name="Exhaust Attacker">
      <bpmn:incoming>AT_14</bpmn:incoming>
      <bpmn:outgoing>AT_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Block" name="Use Block Ability?">
      <bpmn:incoming>AT_09</bpmn:incoming>
      <bpmn:outgoing>AT_10</bpmn:outgoing>
      <bpmn:outgoing>AT_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ChooseReactionAttack" name="Choose Reaction, Targets or Decline">
      <bpmn:incoming>AT_25</bpmn:incoming>
      <bpmn:incoming>AT_29</bpmn:incoming>
      <bpmn:outgoing>AT_03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_AttackReaction" name="Use Reaction?">
      <bpmn:incoming>AT_28</bpmn:incoming>
      <bpmn:outgoing>AT_04</bpmn:outgoing>
      <bpmn:outgoing>AT_08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ChangeFinalTarget" name="Change Final Target to Blocking Unit">
      <bpmn:incoming>AT_33</bpmn:incoming>
      <bpmn:outgoing>AT_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="AT_06" sourceRef="Task_ResolveAttackReaction" targetRef="Task_CancelAttack" />
    <bpmn:sequenceFlow id="AT_07" sourceRef="Task_CancelAttack" targetRef="End_AttackCancelled" />
    <bpmn:serviceTask id="Task_PayAttackReactionCost" name="Pay Reaction Cost">
      <bpmn:documentation>After validation, deduct the configured cost from the payer. Transfer any Momentum spent to the opponent. Invalid choices do not spend resources.</bpmn:documentation>
      <bpmn:incoming>AT_04</bpmn:incoming>
      <bpmn:outgoing>AT_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ResolveAttackReaction" name="Resolve Reaction">
      <bpmn:documentation>Execute the Reaction Resolution using the common Resolution contract in this Process and ../../model/effect-resolution-model.md. Active Player order for sequential multi-player effects does not depend on Reaction Source ownership. Return the state applied so far and any fixed terminal result.</bpmn:documentation>
      <bpmn:incoming>AT_05</bpmn:incoming>
      <bpmn:outgoing>AT_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CancelAttack" name="Cancel Attack">
      <bpmn:documentation>Record cancellation of the Attack even when the Reaction has already fixed the Game result. Preserve costs and effects already applied. This reporting adds no gameplay effects and never changes the fixed result; do not proceed to Block or Combat.</bpmn:documentation>
      <bpmn:incoming>AT_06</bpmn:incoming>
      <bpmn:outgoing>AT_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_AttackCancelled" name="Operation Incomplete">
      <bpmn:documentation>Return operationCompleted = false and the state applied so far to turn-flow.bpmn. If the Reaction ended the Game, also return gameEnded = true and the already-fixed result; otherwise return gameEnded = false. Turn Flow must not reevaluate the result or reselect after Game end.</bpmn:documentation>
      <bpmn:incoming>AT_07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_ChooseBlock" name="Choose Block or No Block">
      <bpmn:incoming>AT_08</bpmn:incoming>
      <bpmn:incoming>AT_32</bpmn:incoming>
      <bpmn:outgoing>AT_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_TargetType" name="Final Target Type?">
      <bpmn:incoming>AT_15</bpmn:incoming>
      <bpmn:outgoing>AT_16</bpmn:outgoing>
      <bpmn:outgoing>AT_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_DamageCore" name="Deal Attacker ATK Damage to Core">
      <bpmn:documentation>Apply attacker ATK damage to the Core as a sequential EffectStep under the common Resolution contract. If a defeat condition is reached, immediately fix gameEnded and the result. The Attack body has resolved; preserve its existing completion record without later processing or result reevaluation.</bpmn:documentation>
      <bpmn:incoming>AT_16</bpmn:incoming>
      <bpmn:outgoing>AT_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_DamageUnits" name="Deal Simultaneous ATK Damage">
      <bpmn:documentation>Apply both Units' ATK damage as one explicit SimultaneousGroup under ../../model/effect-resolution-model.md, then perform the Destroy Check. Active Player order never divides this simultaneous damage into sequential Player effects.</bpmn:documentation>
      <bpmn:incoming>AT_17</bpmn:incoming>
      <bpmn:outgoing>AT_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_DestroyCheck" name="Destroy Units with Current HP &#60;= 0">
      <bpmn:documentation>Destroy Units whose Current HP is zero or below and move them to their owners' Discards. Current visibility follows ../../model/information-model.md: owners may inspect their Discard contents, opponents may inspect only the count. Past observations of a Public Unit belong to Player knowledge and are not erased by this visibility change.</bpmn:documentation>
      <bpmn:incoming>AT_34</bpmn:incoming>
      <bpmn:incoming>AT_18</bpmn:incoming>
      <bpmn:outgoing>AT_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_AttackComplete" name="Attack Resolution End">
      <bpmn:documentation>Return operationCompleted = true, gameEnded = false, and the updated combat state to turn-flow.bpmn. Do not transfer control here.</bpmn:documentation>
      <bpmn:incoming>AT_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="AT_18" sourceRef="Task_DamageUnits" targetRef="Task_DestroyCheck" />
    <bpmn:sequenceFlow id="AT_19" sourceRef="Task_DestroyCheck" targetRef="End_AttackComplete" />
    <bpmn:serviceTask id="Task_ValidateAttack" name="Validate Attack">
      <bpmn:documentation>Check that the attacker is ready and attack-enabled and that the declared enemy Core or Unit target is legal. Do not exhaust the attacker at declaration.</bpmn:documentation>
      <bpmn:incoming>AT_02</bpmn:incoming>
      <bpmn:outgoing>AT_24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_AttackValid" name="Attack Valid?">
      <bpmn:incoming>AT_24</bpmn:incoming>
      <bpmn:outgoing>AT_25</bpmn:outgoing>
      <bpmn:outgoing>AT_26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="AT_24" sourceRef="Task_ValidateAttack" targetRef="Gateway_AttackValid" />
    <bpmn:sequenceFlow id="AT_25" name="Yes" sourceRef="Gateway_AttackValid" targetRef="Task_ChooseReactionAttack">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">attackValid</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="AT_26" name="No" sourceRef="Gateway_AttackValid" targetRef="Task_DeclareAttack">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not(attackValid)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Task_ValidateAttackReaction" name="Validate Reaction">
      <bpmn:documentation>Declining is a valid choice. For a selected reaction, check its source, timing, targets, and ability to pay. Invalid input returns to reaction selection without costs, effects, or cancellation.</bpmn:documentation>
      <bpmn:incoming>AT_03</bpmn:incoming>
      <bpmn:outgoing>AT_27</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_AttackReactionValid" name="Reaction Valid?">
      <bpmn:incoming>AT_27</bpmn:incoming>
      <bpmn:outgoing>AT_28</bpmn:outgoing>
      <bpmn:outgoing>AT_29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="AT_27" sourceRef="Task_ValidateAttackReaction" targetRef="Gateway_AttackReactionValid" />
    <bpmn:sequenceFlow id="AT_28" name="Yes" sourceRef="Gateway_AttackReactionValid" targetRef="Gateway_AttackReaction">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">reactionValid</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="AT_29" name="No" sourceRef="Gateway_AttackReactionValid" targetRef="Task_ChooseReactionAttack">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not(reactionValid)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Task_ValidateBlock" name="Validate Block">
      <bpmn:documentation>Check the selected unit has a usable Block ability and can pay its cost. Invalid input returns to the block decision, allowing another blocker or no block; do not pay or change the target.</bpmn:documentation>
      <bpmn:incoming>AT_11</bpmn:incoming>
      <bpmn:outgoing>AT_30</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_BlockValid" name="Block Valid?">
      <bpmn:incoming>AT_30</bpmn:incoming>
      <bpmn:outgoing>AT_31</bpmn:outgoing>
      <bpmn:outgoing>AT_32</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_PayBlockCost" name="Pay Block Cost">
      <bpmn:documentation>After validation, deduct the configured cost from the payer. Transfer any Momentum spent to the opponent. Invalid choices do not spend resources.</bpmn:documentation>
      <bpmn:incoming>AT_31</bpmn:incoming>
      <bpmn:outgoing>AT_33</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="AT_30" sourceRef="Task_ValidateBlock" targetRef="Gateway_BlockValid" />
    <bpmn:sequenceFlow id="AT_31" name="Yes" sourceRef="Gateway_BlockValid" targetRef="Task_PayBlockCost">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">blockValid</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="AT_32" name="No" sourceRef="Gateway_BlockValid" targetRef="Task_ChooseBlock">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not(blockValid)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="AT_33" sourceRef="Task_PayBlockCost" targetRef="Task_ChangeFinalTarget" />
    <bpmn:exclusiveGateway id="Gateway_AttackGameEnded" name="Game Ended?">
      <bpmn:documentation>Use the result fixed at Core damage. Continue only if the Game has not ended.</bpmn:documentation>
      <bpmn:incoming>AT_20</bpmn:incoming>
      <bpmn:outgoing>AT_34</bpmn:outgoing>
      <bpmn:outgoing>AT_35</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_AttackGameEnded" name="Game End Reported">
      <bpmn:documentation>Return gameEnded = true and the already-fixed result with the state applied so far. The Core attack body is resolved, so retain its existing operationCompleted = true report without applying any later gameplay effect.</bpmn:documentation>
      <bpmn:incoming>AT_35</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="AT_34" name="No" sourceRef="Gateway_AttackGameEnded" targetRef="Task_DestroyCheck">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not(gameEnded)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="AT_35" name="Yes" sourceRef="Gateway_AttackGameEnded" targetRef="End_AttackGameEnded">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">gameEnded</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Collaboration_AttackFlow">
    <bpmndi:BPMNPlane id="BPMNPlane_Collaboration_AttackFlow" bpmnElement="Collaboration_AttackFlow">
      <bpmndi:BPMNShape id="Participant_Attack_di" bpmnElement="Participant_Attack" isHorizontal="true">
        <dc:Bounds x="60" y="60" width="3300" height="940" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_AttackSystem_di" bpmnElement="Lane_AttackSystem" isHorizontal="true">
        <dc:Bounds x="90" y="400" width="3270" height="600" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Defender_di" bpmnElement="Lane_Defender" isHorizontal="true">
        <dc:Bounds x="90" y="220" width="3270" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Attacker_di" bpmnElement="Lane_Attacker" isHorizontal="true">
        <dc:Bounds x="90" y="60" width="3270" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DeclareAttack_di" bpmnElement="Task_DeclareAttack">
        <dc:Bounds x="350" y="130" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_AttackSelected_di" bpmnElement="Start_AttackSelected">
        <dc:Bounds x="150" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="98" y="196" width="140" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SelectBlockingUnit_di" bpmnElement="Task_SelectBlockingUnit">
        <dc:Bounds x="1570" y="260" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AttackCommit_di" bpmnElement="Task_AttackCommit">
        <dc:Bounds x="2280" y="620" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ExhaustAttacker_di" bpmnElement="Task_ExhaustAttacker">
        <dc:Bounds x="2460" y="620" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Block_di" bpmnElement="Gateway_Block" isMarkerVisible="true">
        <dc:Bounds x="1450" y="485" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1490" y="550" width="110" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ChooseReactionAttack_di" bpmnElement="Task_ChooseReactionAttack">
        <dc:Bounds x="700" y="260" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_AttackReaction_di" bpmnElement="Gateway_AttackReaction" isMarkerVisible="true">
        <dc:Bounds x="1050" y="485" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1010" y="440" width="130" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ChangeFinalTarget_di" bpmnElement="Task_ChangeFinalTarget">
        <dc:Bounds x="2090" y="470" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PayAttackReactionCost_di" bpmnElement="Task_PayAttackReactionCost">
        <dc:Bounds x="1200" y="840" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ResolveAttackReaction_di" bpmnElement="Task_ResolveAttackReaction">
        <dc:Bounds x="1390" y="840" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CancelAttack_di" bpmnElement="Task_CancelAttack">
        <dc:Bounds x="1580" y="840" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_AttackCancelled_di" bpmnElement="End_AttackCancelled">
        <dc:Bounds x="1790" y="862" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1738" y="906" width="140" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ChooseBlock_di" bpmnElement="Task_ChooseBlock">
        <dc:Bounds x="1200" y="260" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_TargetType_di" bpmnElement="Gateway_TargetType" isMarkerVisible="true">
        <dc:Bounds x="2650" y="635" width="50" height="50" />
