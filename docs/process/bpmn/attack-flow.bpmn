      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_AttackCancelled_di" bpmnElement="End_AttackCancelled">
        <dc:Bounds x="632" y="722" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="580" y="770" width="140" height="40" />
