        <di:waypoint x="720" y="740"/>
        <di:waypoint x="750" y="740"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AT_04_di" bpmnElement="AT_04">
        <di:waypoint x="800" y="740"/>
        <di:waypoint x="870" y="740"/>
        <di:waypoint x="870" y="455"/>
        <di:waypoint x="940" y="455"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AT_05_di" bpmnElement="AT_05">
        <di:waypoint x="1070" y="455"/>
        <di:waypoint x="1100" y="455"/>
        <di:waypoint x="1100" y="755"/>
        <di:waypoint x="1130" y="755"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AT_06_di" bpmnElement="AT_06">
        <di:waypoint x="1260" y="755"/>
        <di:waypoint x="1290" y="755"/>
        <di:waypoint x="1290" y="755"/>
        <di:waypoint x="1320" y="755"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AT_07_di" bpmnElement="AT_07">
        <di:waypoint x="1450" y="755"/>
        <di:waypoint x="1480" y="755"/>
        <di:waypoint x="1480" y="733"/>
        <di:waypoint x="1510" y="733"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AT_08_di" bpmnElement="AT_08">
        <di:waypoint x="800" y="740"/>
        <di:waypoint x="870" y="740"/>
        <di:waypoint x="870" y="555"/>
        <di:waypoint x="940" y="555"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AT_09_di" bpmnElement="AT_09">
        <di:waypoint x="1070" y="555"/>
        <di:waypoint x="1100" y="555"/>
        <di:waypoint x="1100" y="840"/>
        <di:waypoint x="1130" y="840"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AT_10_di" bpmnElement="AT_10">
        <di:waypoint x="1180" y="840"/>
        <di:waypoint x="1250" y="840"/>
        <di:waypoint x="1250" y="455"/>
        <di:waypoint x="1320" y="455"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AT_11_di" bpmnElement="AT_11">
        <di:waypoint x="1450" y="455"/>
        <di:waypoint x="1480" y="455"/>
