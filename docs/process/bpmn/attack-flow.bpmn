      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ChooseBlock_di" bpmnElement="Task_ChooseBlock">
        <dc:Bounds x="805" y="260" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_TargetType_di" bpmnElement="Gateway_TargetType" isMarkerVisible="true">
        <dc:Bounds x="1695" y="565" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1655" y="525" width="130" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DamageCore_di" bpmnElement="Task_DamageCore">
        <dc:Bounds x="1855" y="700" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_GameEnded_di" bpmnElement="End_GameEnded">
        <dc:Bounds x="2642" y="722" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2610" y="770" width="100" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DamageUnits_di" bpmnElement="Task_DamageUnits">
        <dc:Bounds x="1855" y="550" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DestroyCheck_di" bpmnElement="Task_DestroyCheck">
        <dc:Bounds x="2080" y="550" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EvaluateGameEnd_di" bpmnElement="Task_EvaluateGameEnd">
        <dc:Bounds x="2295" y="550" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_GameEndAttack_di" bpmnElement="Gateway_GameEndAttack" isMarkerVisible="true">
        <dc:Bounds x="2465" y="565" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2430" y="525" width="120" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_AttackComplete_di" bpmnElement="End_AttackComplete">
        <dc:Bounds x="2642" y="572" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2610" y="620" width="100" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="AT_01_di" bpmnElement="AT_01">
        <di:waypoint x="216" y="150" />
        <di:waypoint x="370" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AT_02_di" bpmnElement="AT_02">
        <di:waypoint x="435" y="190" />
        <di:waypoint x="435" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AT_03_di" bpmnElement="AT_03">
        <di:waypoint x="435" y="340" />
        <di:waypoint x="435" y="565" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AT_04_di" bpmnElement="AT_04">
        <di:waypoint x="410" y="590" />
        <di:waypoint x="340" y="590" />
        <di:waypoint x="340" y="300" />
        <di:waypoint x="310" y="300" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="365" y="568" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AT_05_di" bpmnElement="AT_05">
        <di:waypoint x="245" y="340" />
        <di:waypoint x="245" y="700" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AT_08_di" bpmnElement="AT_08">
